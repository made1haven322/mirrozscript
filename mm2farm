local function findCoins()
    local coins = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "TouchInterest" and obj:IsA("TouchTransmitter") then
            local part = obj.Parent
            if part and part:IsA("BasePart") then
                local ok, p = false, part
                while p do
                    if p.Name == "CoinContainer" then ok = true; break end
                    p = p.Parent
                end
                if ok then
                    table.insert(coins, part)
                end
            end
        end
    end
    return coins
end

local function moveTo(targetPos, speed)
    local start    = hrp.Position
    local dist     = (targetPos - start).Magnitude
    local duration = math.max(dist / speed, 0.15)
    local t        = 0
    while t < duration do
        if not running then return end
        local dt = RunService.Heartbeat:Wait()
        t += dt
        local alpha = math.min(t / duration, 1)
        local pos   = start:Lerp(targetPos, alpha)
        hrp.CFrame  = CFrame.new(pos) * LYING_ANGLE
    end
    hrp.CFrame = CFrame.new(targetPos) * LYING_ANGLE
end

local function waitForCollect(coin, timeout)
    local waited = 0
    while coin.Parent and coin:FindFirstChild("TouchInterest") and waited < timeout do
        task.wait(0.06)
        waited += 0.06
    end
    return not coin.Parent or not coin:FindFirstChild("TouchInterest")
end

local function collectLoop()
    while running do
        local coins = findCoins()
        if #coins == 0 then
            status.Text = "no coins, waiting..."
            task.wait(0.8)
            continue
        end

        table.sort(coins, function(a, b)
            return (a.Position - hrp.Position).Magnitude
                 < (b.Position - hrp.Position).Magnitude
        end)

        local coin    = coins[1]
        local coinPos = coin.Position

        status.Text = "flying under..."
        moveTo(Vector3.new(coinPos.X, coinPos.Y - CFG.UnderOffset, coinPos.Z), CFG.SpeedUnder)
        if not running then break end
        task.wait(0.08)

        local success = false
        for attempt = 1, CFG.MaxRetries do
            status.Text = ("collecting... (%d/%d)"):format(attempt, CFG.MaxRetries)

            moveTo(coinPos, CFG.SpeedUp)
            if not running then break end

            if waitForCollect(coin, CFG.WaitTimeout) then
                success = true
                break
            end

            if attempt < CFG.MaxRetries then
                hrp.CFrame = CFrame.new(Vector3.new(coinPos.X, coinPos.Y - CFG.UnderOffset, coinPos.Z)) * LYING_ANGLE
                task.wait(0.15)
            end
        end

        if not success then
            status.Text = "coin skipped"
        end

        hrp.CFrame = CFrame.new(coinPos + Vector3.new(0, 3, 0)) * LYING_ANGLE
        task.wait(0.35 + math.random() * 0.25)
    end
end

local function freezeCharacter()
    hum.PlatformStand = true
    hum.WalkSpeed     = 0
    hum.JumpPower     = 0
    hum.JumpHeight    = 0
    hrp.CanCollide    = false
end

local function unfreezeCharacter()
    hum.PlatformStand = false
    hum.WalkSpeed     = 16
    hum.JumpPower     = 50
    hum.JumpHeight    = 7.2
    hrp.CanCollide    = true
end

local function start()
    running = true
    updateToggleVisual()
    status.Text = "starting..."

    freezeCharacter()

    mainThread = task.spawn(function()
        local ok, err = pcall(collectLoop)
        if not ok then
            status.Text = "error: " .. tostring(err)
        end
    end)
end

local function stop()
    running = false
    updateToggleVisual()
    status.Text = "stopped"

    if mainThread then
        task.cancel(mainThread)
        mainThread = nil
    end

    unfreezeCharacter()
end

toggle.MouseButton1Click:Connect(function()
    if running then stop() else start() end
end)

lp.CharacterAdded:Connect(function(c)
    char = c
    hrp  = c:WaitForChild("HumanoidRootPart")
    hum  = c:WaitForChild("Humanoid")
    if running then stop() end
end)
