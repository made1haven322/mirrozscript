local dragging, dragStart, startFramePos, startShadowPos, startGlowPos

frame.InputBegan:Connect(function(input)
    if dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging       = true
        dragStart      = input.Position
        startFramePos  = frame.Position
        startShadowPos = shadow.Position
        startGlowPos   = glow.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
       and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local delta = input.Position - dragStart
    frame.Position  = UDim2.new(startFramePos.X.Scale,  startFramePos.X.Offset  + delta.X, startFramePos.Y.Scale,  startFramePos.Y.Offset  + delta.Y)
    shadow.Position = UDim2.new(startShadowPos.X.Scale, startShadowPos.X.Offset + delta.X, startShadowPos.Y.Scale, startShadowPos.Y.Offset + delta.Y)
    glow.Position   = UDim2.new(startGlowPos.X.Scale,   startGlowPos.X.Offset   + delta.X, startGlowPos.Y.Scale,   startGlowPos.Y.Offset   + delta.Y)
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local function disablePartCollision(part)
    if part:IsA("BasePart") and part.CanCollide then
        part.CanCollide = false
    end
end

local function stripAccessories(root)
    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("Accessory") then
            local handle = child:FindFirstChildWhichIsA("BasePart")
            if handle then handle:Destroy() end
        end
    end
end

local function killTouchTransmitters(root)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("TouchTransmitter") then d:Destroy() end
    end
end

local function antiFlingStep()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == lp then continue end
        local c = plr.Character
        if not c then continue end

        local hrpOther = c:FindFirstChild("HumanoidRootPart")
        if hrpOther then
            hrpOther.CanCollide = false
            killTouchTransmitters(hrpOther)
        end

        for _, part in ipairs(c:GetChildren()) do
            disablePartCollision(part)
        end

        stripAccessories(c)
    end

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Accessory") then
            local handle = obj:FindFirstChildWhichIsA("BasePart")
            if handle then handle:Destroy() end
        end
    end
end

function toggleAntiFling(state)
    antiFlingOn = state
    if state then
        afSwitch.BackgroundColor3 = Color3.fromRGB(0, 200, 130)
        afKnob.Position            = UDim2.new(1, -23, 0.5, -10)
        afKnob.BackgroundColor3    = Color3.fromRGB(255, 255, 255)

        antiFlingStep()
        antiFlingConn = RunService.Heartbeat:Connect(function(dt)
            if dt < CFG.AntiFlingTick then return end
            antiFlingStep()
        end)
    else
        afSwitch.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
        afKnob.Position            = UDim2.new(0, 3, 0.5, -10)
        afKnob.BackgroundColor3    = Color3.fromRGB(200, 200, 210)

        if antiFlingConn then
            antiFlingConn:Disconnect()
            antiFlingConn = nil
        end
    end
end

afSwitch.MouseButton1Click:Connect(function()
    toggleAntiFling(not antiFlingOn)
end)

