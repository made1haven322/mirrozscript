local function getViewportPoint(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        return input.Position
    end
    return UserInputService:GetMouseLocation()
end

local function isValidTarget(part)
    if not part or not part:IsA("BasePart") then return false end
    if part.Name ~= "Grass" then return false end
    return part == ground or part:IsDescendantOf(ground)
end

local function updateHighlight()
    if not selectedPart then
        highlight.Adornee = nil
        return
    end
    if selectionEnabled then
        highlight.Adornee = selectedPart
    else
        local sinceLift = tick() - lastLiftTick
        if sinceLift <= HIGHLIGHT_LINGER then
            highlight.Adornee = selectedPart
        else
            highlight.Adornee = nil
        end
    end
end

local function updateSlider(value)
    currentLift = math.clamp(value, 0, maxLift)
    local percent = currentLift / maxLift
    sliderFill.Size = UDim2.new(percent, 0, 1, 0)
    sliderKnob.Position = UDim2.new(percent, -11, 0, 0)
    valueLabel.Text = string.format("%.1f st", currentLift)
    if selectedPart and originalPositions[selectedPart] then
        selectedPart.Position = originalPositions[selectedPart] + Vector3.new(0, currentLift, 0)
        statusLabel.Text = string.format("Выбран: %s (+%.1f)", selectedPart.Name, currentLift)
        if currentLift > 0 then
            lastLiftTick = tick()
        end
    end
end

local function selectPart(part)
    if not isValidTarget(part) then
        if part and part:IsA("BasePart") then
            hintLabel.Text = "Это не Grass"
        end
        return
    end
    if selectedPart == part then return end
    selectedPart = part
    if not originalPositions[part] then
        originalPositions[part] = part.Position
        if not part.Anchored then
            part.Anchored = true
        end
    end
    hintLabel.Text = "Grass выбран — тяни слайдер вверх"
    updateSlider(0)
    lastLiftTick = tick()
end

local sliderDragging = false
local function updateSliderFromInput(input)
    local vp = getViewportPoint(input)
    local framePos = sliderFrame.AbsolutePosition.X
    local frameWidth = sliderFrame.AbsoluteSize.X
    local percent = math.clamp((vp.X - framePos) / frameWidth, 0, 1)
    updateSlider(percent * maxLift)
end

sliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateSliderFromInput(input)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSliderFromInput(input)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)

resetButton.MouseButton1Click:Connect(function()
    if selectedPart and originalPositions[selectedPart] then
        selectedPart.Position = originalPositions[selectedPart]
        updateSlider(0)
        statusLabel.Text = "Выбран: " .. selectedPart.Name .. " (сброшен)"
    end
end)

toggleButton.MouseButton1Click:Connect(function()
    selectionEnabled = not selectionEnabled
    toggleButton.Text = selectionEnabled and "Выбор: ВКЛ" or "Выбор: ВЫКЛ"
    toggleButton.TextColor3 = selectionEnabled and Color3.fromRGB(120, 255, 170) or Color3.fromRGB(255, 140, 140)
    toggleButton.BackgroundColor3 = selectionEnabled and Color3.fromRGB(40, 70, 55) or Color3.fromRGB(70, 40, 44)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not selectionEnabled or sliderDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local camera = Workspace.CurrentCamera
        if not camera then return end
        local vp = getViewportPoint(input)
        local ray = camera:ViewportPointToRay(vp.X, vp.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {player.Character}
        local result = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
        if result and result.Instance then
            selectPart(result.Instance)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    updateHighlight()
end)
